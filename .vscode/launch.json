{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/api_server/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/api_server",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "MCP Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/mcp_server/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/mcp_server",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "API Server Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}/api_server",
            "args": [
                "app/tests"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/api_server"
            },
            "justMyCode": false
        },
        {
            "name": "API Test Current File",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}/api_server",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/api_server"
            },
            "justMyCode": false
        },
        {
            "name": "MCP Server Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}/mcp_server",
            "args": [],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/mcp_server"
            },
            "justMyCode": false
        },
        {
            "name": "MCP Test Current File",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}/mcp_server",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/mcp_server"
            },
            "justMyCode": false
        }
    ]
}